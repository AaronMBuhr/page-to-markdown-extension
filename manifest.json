{
    "manifest_version": 3,
    "name": "Page → Markdown (Image Refs)",
    "version": "0.2.0",
    "description": "Convert the current page into Markdown with reference-style images collected at the bottom.",
    "permissions": ["activeTab"],
    "host_permissions": ["<all_urls>"],
    "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "action": {
      "default_title": "Convert page to Markdown",
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png"
      }
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["contentScript.js"],
        "run_at": "document_idle"
      }
    ]
  }
  